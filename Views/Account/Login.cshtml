@model CandidateRegistrationPortal.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-card">
    <h1>Login</h1>
    <p class="auth-subtitle">Welcome back.</p>

    <form asp-action="Login" method="post" class="form-stack">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert error"></div>

        <div class="form-group">
            <label for="UserName">User name <span class="required">*</span></label>
            <input asp-for="UserName" autocomplete="username" />
            <span asp-validation-for="UserName" class="field-error"></span>
        </div>

        <div class="form-group">
            <label for="Password">Password <span class="required">*</span></label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-group">
            <label for="OTP">OTP <span class="required">*</span></label>
            <input asp-for="OTP" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
            <span asp-validation-for="OTP" class="field-error"></span>
            <div class="info-panel">Offline OTP for demo: <strong>@ViewBag.DemoOtp</strong></div>
        </div>

        <div class="form-group">
            <label for="Captcha">Captcha <span class="required">*</span></label>
            <div class="captcha-box">@ViewBag.CaptchaQuestion</div>
            <input asp-for="Captcha" maxlength="3" inputmode="numeric" />
            <span asp-validation-for="Captcha" class="field-error"></span>
        </div>

        <button type="submit" class="btn-primary">Login</button>
    </form>

    <div class="demo-note">
        Demo admin: <strong>admin / Admin@123</strong>. Offline OTP is shown on this page by design.
    </div>
</section>
